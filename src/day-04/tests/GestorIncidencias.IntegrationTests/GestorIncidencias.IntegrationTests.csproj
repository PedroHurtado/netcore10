<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PRUEBAS DE INTEGRACIÓN: arrancan la aplicación COMPLETA en memoria (WebApplicationFactory)
    y le hacen peticiones HTTP de verdad: middleware, autenticación, autorización, controladores, EF Core...
    Sin abrir ningún puerto ni navegador.

      Microsoft.AspNetCore.Mvc.Testing → WebApplicationFactory<Program> y TestServer
  -->

  <!--
    xUnit v3 genera un EJECUTABLE (OutputType Exe) que usa Microsoft.Testing.Platform: por eso el global.json
    de la carpeta de la solución activa ese modo en "dotnet test". Microsoft.NET.Test.Sdk y xunit.runner.visualstudio
    permiten además que el Explorador de pruebas de Visual Studio y de VS Code las encuentre.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GestorIncidencias.Web\GestorIncidencias.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
