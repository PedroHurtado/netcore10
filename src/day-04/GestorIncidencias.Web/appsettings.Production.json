{
  "Logging": {
    "Console": {
      // En producción, cada línea de log es un objeto JSON: lo entiende cualquier recolector
      // (Seq, Elasticsearch, Azure Monitor, Loki...) sin expresiones regulares.
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  }
}
