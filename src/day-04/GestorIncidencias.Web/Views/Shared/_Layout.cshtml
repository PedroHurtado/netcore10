@* Layout = la "página maestra" (equivalente a Site.Master en Web Forms) *@
@inject IWebHostEnvironment Entorno
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Gestor de Incidencias</title>
    @* site.min.css se genera al compilar a partir de site.css (tarea MinificarCss del .csproj) *@
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a class="marca" asp-controller="Home" asp-action="Index">Gestor de Incidencias</a>
            <a asp-controller="Incidencias" asp-action="Index">Incidencias (MVC)</a>
            <a asp-controller="Incidencias" asp-action="Crear">Nueva (MVC)</a>
            <a asp-page="/Paginas/Incidencias/Index">Razor Pages</a>
            @* Lo que se muestra depende del usuario (User = HttpContext.User, lo rellena UseAuthentication) *@
            @if (User.IsInRole(Roles.Administrador))
            {
                <a asp-controller="Usuarios" asp-action="Index">Usuarios</a>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="usuario">@(User.FindFirst(TiposClaim.NombreCompleto)?.Value ?? User.Identity.Name)</span>
                @* Cerrar sesión es un POST con token antiforgery, nunca un enlace GET *@
                <form asp-controller="Cuenta" asp-action="Logout" method="post" class="form-salir">
                    <button type="submit" class="boton-enlace">Salir</button>
                </form>
            }
            else
            {
                <a asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
            }
        </nav>
    </header>

    <main>
        <partial name="_Mensajes" />

        @* Aquí se inserta el contenido de cada vista (como ContentPlaceHolder en Web Forms) *@
        @RenderBody()
    </main>

    <footer>
        Curso ASP.NET Core · Día 4 · Entorno: <strong>@Entorno.EnvironmentName</strong>
    </footer>

    @* Las vistas pueden añadir scripts propios con @section Scripts { ... } *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
