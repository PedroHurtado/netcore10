{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  // MapStaticAssets en Development sirve TODO con "Cache-Control: no-cache".
  // Con esto las URLs con huella (site.min.x4wtre2m4d.css) van con "max-age=31536000, immutable", igual que al publicar.
  "EnableStaticAssetsDevelopmentCaching": true,
  "Incidencias": {
    "NombreAplicacion": "Gestor de Incidencias [DEV]",
    "MaxIncidenciasAbiertas": 10,
    "CargarDatosDemo": true,
    "IncidenciasHistoricasDemo": 200
  }
}
