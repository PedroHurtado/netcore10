@model IncidenciaDetalleDto
@{
    var incidencia = Model.Incidencia;
    ViewData["Title"] = $"Incidencia {incidencia.Id}";
}

<p><a asp-action="Index">← Volver al listado</a></p>

<h1>#@incidencia.Id · @incidencia.Titulo</h1>

<dl class="ficha">
    <dt>Estado</dt>
    <dd><partial name="_Estado" model="incidencia.Estado" /></dd>

    <dt>Prioridad</dt>
    <dd class="prioridad-@incidencia.Prioridad.ToString().ToLowerInvariant()">@incidencia.Prioridad</dd>

    <dt>Categoría</dt>
    <dd>@(incidencia.Categoria ?? "—")</dd>

    <dt>Descripción</dt>
    <dd>@(incidencia.Descripcion ?? "—")</dd>

    <dt>Fecha de alta</dt>
    <dd>@incidencia.FechaAlta.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

    <dt>Fecha de resolución</dt>
    <dd>@(incidencia.FechaResolucion?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
</dl>

@*
    Cada acción es un pequeño formulario POST (cambia datos → nunca con GET).
    El Tag Helper <form> añade automáticamente el campo oculto __RequestVerificationToken (antiforgery).
    La vista solo decide QUÉ botones enseñar; si alguien fuerza el POST, el dominio lo rechaza igualmente.
*@
<div class="acciones">
    @if (incidencia.Estado == EstadoIncidencia.Abierta)
    {
        <form asp-action="Iniciar" asp-route-id="@incidencia.Id" method="post">
            <button type="submit" class="boton-secundario">Iniciar</button>
        </form>
    }
    @if (incidencia.Estado is EstadoIncidencia.Abierta or EstadoIncidencia.EnCurso)
    {
        <form asp-action="Resolver" asp-route-id="@incidencia.Id" method="post">
            <button type="submit" class="boton">Resolver</button>
        </form>
    }
    @if (incidencia.Estado == EstadoIncidencia.Resuelta)
    {
        <form asp-action="Cerrar" asp-route-id="@incidencia.Id" method="post">
            <button type="submit" class="boton-secundario">Cerrar</button>
        </form>
        <form asp-action="Reabrir" asp-route-id="@incidencia.Id" method="post">
            <button type="submit" class="boton-secundario">Reabrir</button>
        </form>
    }
</div>

@* Comentarios: la relación 1:N Incidencia → Comentarios *@
<h2>Comentarios (@Model.Comentarios.Count)</h2>

@if (Model.Comentarios.Count == 0)
{
    <p class="vacio">Todavía no hay comentarios.</p>
}
else
{
    <ol class="comentarios">
        @foreach (var comentario in Model.Comentarios)
        {
            <li>
                <div class="comentario-cabecera">
                    <strong>@comentario.Autor</strong> · @comentario.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>
                <div>@comentario.Texto</div>
            </li>
        }
    </ol>
}

@if (incidencia.Estado != EstadoIncidencia.Cerrada)
{
    @* Los nombres de los campos (Texto, Autor) coinciden con ComentarioFormulario → model binding en la acción Comentar *@
    <form asp-action="Comentar" asp-route-id="@incidencia.Id" method="post" class="formulario">
        <div class="campo">
            <label for="Autor">Autor</label>
            <input id="Autor" name="Autor" maxlength="@Comentario.AutorLongitudMaxima" required />
        </div>
        <div class="campo">
            <label for="Texto">Comentario</label>
            <textarea id="Texto" name="Texto" rows="3" maxlength="@Comentario.TextoLongitudMaxima" required></textarea>
        </div>
        <button type="submit" class="boton-secundario">Añadir comentario</button>
    </form>
}
