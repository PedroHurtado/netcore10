@model LoginFormulario
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

@* El ReturnUrl viaja en un campo oculto: tras identificarse, el usuario vuelve a la página que pidió *@
<form asp-action="Login" method="post" class="formulario">
    <div asp-validation-summary="ModelOnly" class="errores"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="campo">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" autocomplete="username" autofocus />
        <span asp-validation-for="Correo" class="error-campo"></span>
    </div>

    <div class="campo">
        <label asp-for="Clave"></label>
        <input asp-for="Clave" autocomplete="current-password" />
        <span asp-validation-for="Clave" class="error-campo"></span>
    </div>

    <div class="campo campo-casilla">
        <input asp-for="Recordarme" />
        <label asp-for="Recordarme"></label>
    </div>

    <div class="acciones">
        <button type="submit" class="boton">Entrar</button>
    </div>
</form>

