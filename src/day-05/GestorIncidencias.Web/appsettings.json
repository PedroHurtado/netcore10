{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Día 4: una línea por petición (método, ruta, código, duración). Ver AddHttpLogging en Program.cs.
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // CSP estricta: ni JavaScript ni CSS inline (ver Middleware/ContentSecurityPolicyMiddleware.cs).
  // En producción se sustituirá en appsettings.Production.json o con la variable de entorno ContentSecurityPolicy.
  "ContentSecurityPolicy": "script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'",
  "Incidencias": {
    "NombreAplicacion": "Gestor de Incidencias",
    "MaxIncidenciasAbiertas": 50,
    "PrioridadPorDefecto": "Media",
    "CargarDatosDemo": false,
    "IncidenciasHistoricasDemo": 0
  }
}
